{{#if flash}}
  <aside ng-controller="FlashCtrl as ctrl">
	  <div class="flash alert alert-{{flash.type}}" ng-hide="ctrl.isHidden">
	    <button type="button" class="close" ng-click="ctrl.closeFlash()">&times;</button>
	    <strong>{{flash.intro}}</strong> {{{flash.message}}}
	  </div>
	</aside>
{{/if}}

