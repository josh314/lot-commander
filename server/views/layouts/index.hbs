<!doctype html>
<html lang="en" ng-app="myApp" ng-controller="RootCtrl" ng-strict-di>
  <head>
    <base href="/">
    <meta charset="utf-8">
    <meta http-equiv="Content-Language" content="en">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="author" content="Joshua Davis">
    {{! DESCRIPTION META }}
    <meta name="description" content="{{description}}">
    <title>{{{title}}}</title>
    {{! Load Stylesheet}}
    <link href="app.css" rel="stylesheet">
  </head>
  <body>
    {{! Flash Message}}
    {{> flash}}
    {{! Load main body}}
    {{{body}}}

    {{!
    Load JavaScripts
    ==================================================
    Placed at the end of the document so the pages load faster
    }}

    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.7.2/tinymce.min.js" integrity="sha512-AHsE0IVoihNpGako20z2Tsgg77r5h9VS20XIKa+ZZ8WzzXxdbiUszgVUmXqpUE8GVUEQ88BKQqtlB/xKIY3tUg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.7.2/plugins/emoticons/plugin.min.js" integrity="sha512-YmvqFMfWT7941M/Oj8LtWZapjh32q2Pr/udepNhnLzZEFUqU3/RVQ1BvqJC/aruJblPCeKnIG0Fr8om6mUkb1w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.7.2/plugins/quickbars/plugin.min.js" integrity="sha512-lMcUlEYRTm1/r3RHyPppCPOMbAhteCtY+xs33Q8HXKGRNK+8lsgU/DQaHAAfRaktv3T4kXYlCosagV24WPNZIA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script type="text/javascript" src="app.js"></script>
    <script type="text/javascript" src="/build/ng-app-server-data.js"></script>
  </body>
</html>